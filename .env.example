# =============================================================================
# AI Provider Configuration
# =============================================================================
# Resolution precedence (env-first):
#   1. process.env  — if set, wins
#   2. DB settings  — per-user values saved via the Settings dialog
#   3. defaults     — hard-coded fallbacks
#
# So if you set OPENAI_API_KEY here, the platform uses it regardless of what
# any admin has saved in the web UI. The Settings dialog will show those
# fields as read-only with an "env" tag. Remove the env var to manage from
# the UI again.
#
# AI_PROVIDER chooses the active provider when no per-user override is set.
# Valid values: "azure" (default) or "openai". If only OPENAI_API_KEY is
# defined (no AZURE_OPENAI_API_KEY), the platform assumes "openai".
AI_PROVIDER=azure

# --- Azure OpenAI (default) ---------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
AZURE_OPENAI_GPT_DEPLOYMENT=gpt-4o

# --- OpenAI (or any OpenAI-compatible endpoint: OpenRouter, LiteLLM, vLLM) ---
# Setting OPENAI_API_KEY here without AZURE_OPENAI_API_KEY makes "openai"
# the default provider, unless AI_PROVIDER explicitly says otherwise.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_GPT_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1

# Azure OpenAI Configuration (for Vite frontend build - kept for compatibility)
VITE_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
VITE_AZURE_OPENAI_API_KEY=your_api_key_here
VITE_AZURE_OPENAI_API_VERSION=2024-02-01
VITE_AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
VITE_AZURE_OPENAI_GPT_DEPLOYMENT=gpt-4o

# App Configuration
VITE_APP_TITLE=Audio Task Manager
VITE_APP_DESCRIPTION=Transcribe audio and organize tasks on a mobile-friendly kanban board
VITE_DEV_PORT=8064
NODE_ENV=production
ALLOW_REGISTRATION=true

# Multi-tenancy (optional)
MULTITENANCY_ENABLED=false

# Storage Configuration
# Use relative path for Cloudflare tunnel compatibility
VITE_API_URL=/api
VITE_USE_BACKEND_STORAGE=false

# PocketID Integration
POCKETID_ADMIN_TOKEN=your_admin_token_here
POCKET_ID_ISSUER=https://login.pocketid.app
POCKET_ID_CLIENT_ID=your_client_id_here
POCKET_ID_CLIENT_SECRET=your_client_secret_here
POCKET_ID_CALLBACK_URL=https://your-domain.com/api/auth/oidc/callback
ENABLE_OIDC=true

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password_here
FROM_EMAIL=noreply@your-domain.com

# Session Configuration
SESSION_SECRET=your_session_secret_here
CSRF_SECRET=your_csrf_secret_here

# Application URLs
APP_URL=https://your-domain.com
API_URL=https://your-domain.com/api

# Google reCAPTCHA v3 (optional - for bot protection)
# Get keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here
RECAPTCHA_SCORE_THRESHOLD=0.5

# Cloudflare DNS automation (optional - for automatic subdomain creation)
# Get API token from: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=your_api_token_here
# CLOUDFLARE_ZONE_ID=your_zone_id_here
# CLOUDFLARE_TARGET_IP=your_server_ip