# Azure OpenAI Configuration
VITE_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
VITE_AZURE_OPENAI_API_KEY=your-api-key-here
VITE_AZURE_OPENAI_API_VERSION=2024-02-01
VITE_AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper-1
VITE_AZURE_OPENAI_GPT_DEPLOYMENT=gpt-4

# App Configuration
VITE_APP_TITLE=Audio Task Manager
VITE_APP_DESCRIPTION=Transcribe audio and organize tasks on a mobile-friendly kanban board
VITE_DEV_PORT=8064
APP_URL=https://your-domain.com
API_URL=https://your-domain.com/api

# Landing Page Configuration (optional - if different from APP_URL)
# LANDING_PAGE_URL=https://your-landing-page.com

# Security Configuration
SESSION_SECRET=change-this-to-a-random-secret-in-production
CSRF_SECRET=change-this-to-a-random-csrf-secret-in-production

# Database Configuration
DB_PATH=./storage/app.db
STORAGE_DIR=./storage

# Registration Configuration
ALLOW_REGISTRATION=true

# Optional: Custom HTTPS certificates for local development (to fix mic permissions)
# VITE_HTTPS_KEY_PATH=./certs/key.pem
# VITE_HTTPS_CERT_PATH=./certs/cert.pem

# PocketID (OIDC) Authentication Configuration
# These environment variables provide default values for OIDC configuration
# Admins can override these values in the Settings UI
#
# Group-based access control:
# - Users in the 'admin' group will become admins in the app
# - Users in the 'user' group will become members in the app
# - Users in the 'viewer' group will be denied access
# - Only 'admin' and 'user' groups are allowed to login
ENABLE_OIDC=false
POCKET_ID_ISSUER=https://pocketid.app
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=
POCKET_ID_CALLBACK_URL=https://your-domain.com/api/auth/oidc/callback
SIGNUP_PAGE=https://your-pocketid-domain.com/signup

# Email Configuration for Signup Invitations
# Configure one of the following options to enable email delivery:

# Option 1: Gmail SMTP (recommended for testing)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your_gmail_app_password
# FROM_EMAIL=noreply@yourdomain.com

# Option 2: SendGrid
# SENDGRID_API_KEY=your_sendgrid_api_key
# FROM_EMAIL=noreply@yourdomain.com

# Option 3: Generic SMTP
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# FROM_EMAIL=noreply@yourdomain.com