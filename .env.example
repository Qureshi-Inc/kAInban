# Azure OpenAI Configuration
VITE_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
VITE_AZURE_OPENAI_API_KEY=your-api-key-here
VITE_AZURE_OPENAI_API_VERSION=2024-02-01
VITE_AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper-1
VITE_AZURE_OPENAI_GPT_DEPLOYMENT=gpt-4

# App Configuration
VITE_APP_TITLE=Audio Task Manager
VITE_APP_DESCRIPTION=Transcribe audio and organize tasks on a mobile-friendly kanban board
VITE_DEV_PORT=8064

# Optional: Custom HTTPS certificates for local development (to fix mic permissions)
# VITE_HTTPS_KEY_PATH=./certs/key.pem
# VITE_HTTPS_CERT_PATH=./certs/cert.pem