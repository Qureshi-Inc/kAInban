# Zitadel OIDC (replaces the legacy PocketID integration)
ZITADEL_ISSUER=https://your-zitadel-instance.example.com
ZITADEL_CLIENT_ID=your_pkce_client_id
OIDC_CALLBACK_URL=https://your-domain.com/api/auth/oidc/callback
# Comma-separated emails. The first user matching this list becomes admin
# on first OIDC sign-in IF no admin already exists in DB (one-shot).
ZITADEL_BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# Local-auth fallback gates (default false). Set true to re-open the local
# login or registration routes during a rollback. Split so re-enabling login
# does not re-open registration.
LOCAL_LOGIN_FALLBACK=false
LOCAL_REGISTER_FALLBACK=false

# Application URLs
APP_URL=https://your-domain.com

# Email Configuration (choose one method)

# Option 1: SendGrid (recommended)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@kainban.com

# Option 2: Generic SMTP
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# FROM_EMAIL=noreply@kainban.com

# Option 3: Gmail (for testing only)
# GMAIL_USER=your-gmail@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password
# FROM_EMAIL=your-gmail@gmail.com

# Other settings
SESSION_SECRET=your_session_secret
STORAGE_DIR=./storage
ALLOW_REGISTRATION=true

# Multi-tenancy (optional)
MULTITENANCY_ENABLED=false

# Cloudflare DNS automation (optional - for automatic subdomain creation)
# Get API token from: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=your_api_token_here
# CLOUDFLARE_ZONE_ID=your_zone_id_here
# CLOUDFLARE_TARGET_IP=your_server_ip

# Google reCAPTCHA v3 (optional - for bot protection)
# Get keys from: https://www.google.com/recaptcha/admin
# RECAPTCHA_SITE_KEY=your_site_key_here
# RECAPTCHA_SECRET_KEY=your_secret_key_here
# RECAPTCHA_SCORE_THRESHOLD=0.5