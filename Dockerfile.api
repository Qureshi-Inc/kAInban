# API Dockerfile
FROM node:20-alpine

WORKDIR /app

# Install build dependencies required for native modules and Alpine compatibility
RUN apk add --no-cache \
    wget \
    python3 \
    py3-setuptools \
    make \
    g++ \
    gcc \
    libc-dev \
    sqlite-dev \
    gcompat \
    libc6-compat

# Copy server package files
COPY server/package*.json ./

# Install ALL dependencies (including dev for building)
# Use npm install for better compatibility (works without exact package-lock.json)
RUN npm install

# Rebuild ALL native modules for Alpine/musl
RUN npm rebuild

# Specifically rebuild better-sqlite3 from source for Alpine compatibility
RUN npm rebuild better-sqlite3 --build-from-source

# Copy server code
COPY server/ ./

# Run as non-root. The node:alpine image ships a `node` user at uid 1000
# (gid 1000) which conveniently matches the typical Linux host user, so the
# bind-mounted ./storage volume stays writable from both sides without chown
# gymnastics. Avoids creating yet another user.
RUN mkdir -p /app/storage && chown -R node:node /app

USER node

# Expose API port
EXPOSE 3001

# Start server
CMD ["npm", "start"]