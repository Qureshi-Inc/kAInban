{
  "name": "kAInban - AI-Powered Task Management",
  "short_name": "kAInban",
  "description": "AI-powered task management with meeting transcription and intelligent task extraction",
  "version": "1.0.0",
  "manifest_version": 2,
  "start_url": "/",
  "display": "standalone",
  "background_color": "#fafafa",
  "theme_color": "#667eea",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "permissions": ["microphone", "storage"],
  "features": ["audio-recording", "file-upload", "offline-storage"]
}
